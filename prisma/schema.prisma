generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  ARCHIVED
  REMOVED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model User {
  id                    String                    @id @default(cuid())
  email                 String                    @unique
  passwordHash          String
  displayName           String
  phone                 String?
  avatarUrl             String?
  role                   UserRole                  @default(USER)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  isBanned              Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  listings              Listing[]
  favorites             Favorite[]
  conversationMembers   ConversationParticipant[]
  messages              Message[]
  reportsCreated        Report[]                  @relation("ReportAuthor")
  reportsReviewed       Report[]                  @relation("ReportReviewer")

  @@index([createdAt])
}

model Territory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  countryCode String?
  currency    String     @default("EUR")
  isActive    Boolean    @default(true)
  locations   Location[]
  listings    Listing[]
}

model Location {
  id          String    @id @default(cuid())
  name        String
  slug        String
  postalCode  String?
  latitude    Float?
  longitude   Float?
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  listings    Listing[]

  @@unique([territoryId, slug])
  @@index([territoryId])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  listings  Listing[]
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)

  @@index([parentId])
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  price       Decimal?      @db.Decimal(12, 2)
  currency    String        @default("EUR")
  status      ListingStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  views       Int           @default(0)
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  territoryId String
  territory   Territory     @relation(fields: [territoryId], references: [id])
  locationId  String?
  location    Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  images      ListingImage[]
  favorites   Favorite[]
  conversations Conversation[]
  reports     Report[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  @@index([status, createdAt])
  @@index([territoryId, categoryId])
  @@index([sellerId])
  @@index([price])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  position  Int      @default(0)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model Conversation {
  id           String                    @id @default(cuid())
  listingId    String
  listing      Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status       ConversationStatus        @default(ACTIVE)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([listingId, updatedAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.Text
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Report {
  id          String       @id @default(cuid())
  reason      String
  details     String?      @db.Text
  status      ReportStatus @default(OPEN)
  listingId   String
  listing     Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewerId  String?
  reviewer    User?        @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([listingId])
}
