# Application
NODE_ENV=production
APP_URL=http://YOUR_UNRAID_IP:3000
APP_PORT=3000

# PostgreSQL
POSTGRES_DB=antiles_market
POSTGRES_USER=antiles
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql://antiles:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/antiles_market

# Redis
REDIS_URL=redis://redis:6379

# Authentication - generate a long random secret before deployment
AUTH_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Persistent Unraid storage
POSTGRES_PATH=/mnt/user/appdata/antilles-market/postgres
REDIS_PATH=/mnt/user/appdata/antilles-market/redis
UPLOADS_PATH=/mnt/user/appdata/antilles-market/uploads
UPLOAD_DIR=/app/uploads
